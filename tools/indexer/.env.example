# Ket noi TiDB Cloud (lay o TiDB Cloud Console -> Connect)
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<prefix>.root
TIDB_PASSWORD=<mat-khau>
TIDB_DATABASE=crm
# CA cua TiDB Cloud — mac dinh doc isrgrootx1.pem o goc repo, thuong khong can dat
# TIDB_CA=E:/CRMOnline/isrgrootx1.pem

# Khoa API Gemini (Google AI Studio) — DUNG CHUNG voi APP_AI_API_KEY cua backend
GEMINI_API_KEY=<api-key>

# PHAI trung app.ai.embed.* ben backend, neu khong vector se nam o hai khong gian khac nhau
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# Free tier ~100 request/phut -> de 90 cho an toan
EMBED_RPM=90
BATCH_SIZE=50
