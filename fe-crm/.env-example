# URL gốc của backend API.
# Local: http://localhost:8080
# Production (Netlify): https://<ten-service>.onrender.com  (KHÔNG có dấu / cuối)
VITE_API_BASE_URL=http://localhost:8080

# Đăng nhập Google — OAuth Client ID (Web) từ Google Cloud Console → Credentials.
# Authorized JavaScript origins: http://localhost:5173 (dev) + domain Netlify (prod).
VITE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Ảnh đại diện — Cloudinary unsigned upload (Dashboard → Settings → Upload → Upload presets, Signing mode = Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=<cloud-name>
VITE_CLOUDINARY_UPLOAD_PRESET=<unsigned-preset>
