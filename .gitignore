# ============================================================
# Tài liệu nội bộ (chỉ giữ README.md)
# ============================================================
*.md
!README.md
!**/README.md
diagrams/
documents/
*.xml
!be-crm/pom.xml
*.txt
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.pdf

# ============================================================
# Thông tin nhạy cảm / Credentials
# ============================================================
# application.properties nay chi chua ${ENV:default} (khong secret) — commit de Render build.
# Secret local nam trong application-local.properties (KHONG commit):
be-crm/src/main/resources/application-local.properties
*.pem
*.key
*.cert
*.p12
*.jks

# ============================================================
# Frontend — fe-crm
# ============================================================
fe-crm/node_modules/
fe-crm/dist/
fe-crm/dist-ssr/
fe-crm/*.local

# ============================================================
# Backend — be-crm
# ============================================================
be-crm/target/
be-crm/**/*.jar
be-crm/**/*.war
be-crm/**/*.class

# ============================================================
# Indexer (embed) — Python (tools/indexer). Chi giu code + README + .env.example
# (.env da bi chan boi muc "Environment files" ben duoi)
# ============================================================
__pycache__/
*.pyc
*.pyo
.venv/
venv/
tools/indexer/*.log

# ============================================================
# Anh & file nhap tam (tai lieu/scratch o goc repo).
# Frontend chi dung SVG (fe-crm/public/vite.svg) nen khong anh huong.
# Neu sau nay frontend can .png/.jpg thi them ngoai le, vd: !fe-crm/src/assets/logo.png
# ============================================================
*.png
*.jpg
*.jpeg
*.gif
*.webp
/_wtest

# ============================================================
# Environment files (giữ lại .example)
# ============================================================
.env
.env.local
.env.*.local
**/.env
**/.env.local
!**/.env.example
!**/.env-example

# ============================================================
# OS / Editor
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.sw?
